# Copie este archivo a .env (o configure estas variables en el panel de su hosting).
# NUNCA escriba la clave en el navegador, en el repositorio ni en el chat.
# Solo las lee la función serverless api/chat.js; sin ellas la demo funciona en modo guion.

# Clave de la API de Anthropic (obligatoria solo para el botón "IA real").
ANTHROPIC_API_KEY=

# Modelo a usar (opcional). Vacío = el predeterminado de api/chat.js (claude-haiku-5-5).
ANTHROPIC_MODEL=
